# .env.example — Copy to .env.local and fill in real values
# This file is committed to the repo as documentation.
# .env.local is gitignored and contains your actual secrets.

# ── Authentication ──
DASHBOARD_PIN=              # 4-8 digit PIN for dashboard access

# ── Weather ──
WEATHER_LAT=40.9892         # Latitude (default: Scarsdale, NY)
WEATHER_LON=-73.7944        # Longitude
WEATHER_DISPLAY_NAME="Scarsdale, NY"  # Display name for UI

# ── Calendar Feeds (ICS URLs) ──
# Add as many as needed. Format: CAL_<ID>_URL, CAL_<ID>_LABEL, CAL_<ID>_COLOR
# The ID must be a unique alphanumeric slug.
CAL_PERSONAL_URL=           # e.g. https://calendar.google.com/calendar/ical/xxx/basic.ics
CAL_PERSONAL_LABEL="My Calendar"
CAL_PERSONAL_COLOR="#6366f1"
CAL_PERSONAL_CATEGORY=person  # person | shared | utility | external

CAL_SPOUSE_URL=
CAL_SPOUSE_LABEL="Partner"
CAL_SPOUSE_COLOR="#ec4899"
CAL_SPOUSE_CATEGORY=person

CAL_FAMILY_URL=
CAL_FAMILY_LABEL="Family"
CAL_FAMILY_COLOR="#10b981"
CAL_FAMILY_CATEGORY=shared

CAL_WASTE_URL=
CAL_WASTE_LABEL="Trash/Recycling"
CAL_WASTE_COLOR="#64748b"
CAL_WASTE_CATEGORY=utility

CAL_HOLIDAYS_URL=
CAL_HOLIDAYS_LABEL="US Holidays"
CAL_HOLIDAYS_COLOR="#ef4444"
CAL_HOLIDAYS_CATEGORY=external

# ── Dashboard Preferences (optional, have defaults) ──
TIMEZONE=America/New_York
TEMPERATURE_UNIT=fahrenheit  # fahrenheit | celsius
TIME_FORMAT=12h              # 12h | 24h
WEEK_START_DAY=0             # 0 = Sunday, 1 = Monday
IDLE_TIMEOUT_MS=90000
CACHE_REVALIDATE_SECONDS=600
